# CCC tailor API (run CCC on 3001 if this app uses 3000)
CCC_API_URL=http://localhost:3001
TAILOR_API_KEY=

# Optional CCC fetch deadline in integer milliseconds (default 95000).
# Fractions are rounded. Values above 95000 are clamped so a 30s body read plus
# the fetch still leave 5s to return 504 before maxDuration (130s).
# CCC_FETCH_TIMEOUT_MS=95000

# Postgres (docker compose up -d)
DATABASE_URL=postgresql://ccc:ccc_frontend_dev@127.0.0.1:5432/ccc_frontend

# Better Auth — BETTER_AUTH_URL must match the browser origin (npm run dev binds 127.0.0.1)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# After the first user exists, public sign-up is closed unless this is true
ALLOW_REGISTRATION=false

# Production: set to true only when a single instance is acceptable (otherwise use a shared store).
# When unset in NODE_ENV=production, tailor returns 503 and job actions return the same
# client-safe unavailable string. That is not a quota 429 and has no Retry-After.
RATE_LIMIT_ALLOW_PROCESS_LOCAL=true

# BFF per-user sliding windows. In-memory and process-local (best-effort, not an account-wide cap).
# Tailor matches CCC defaults.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60000
# Looser cap for Kanban mutations (same window)
JOB_RATE_LIMIT_MAX=30
