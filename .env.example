# CCC tailor API (run CCC on 3001 if this app uses 3000)
CCC_API_URL=http://localhost:3001
TAILOR_API_KEY=

# Postgres (docker compose up -d)
DATABASE_URL=postgresql://ccc:ccc_frontend_dev@127.0.0.1:5432/ccc_frontend

# Better Auth — BETTER_AUTH_URL must match the browser origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# After the first user exists, public sign-up is closed unless this is true
ALLOW_REGISTRATION=false

# Client IP forwarded to CCC for its per-IP rate limit.
# Unset: send 127.0.0.1 and ignore inbound IP headers (local and unknown hosts).
# vercel: trust the first address in x-vercel-forwarded-for.
# On Vercel, VERCEL=1 already selects that header unless this is set to none.
# CCC_TRUSTED_PROXY=
