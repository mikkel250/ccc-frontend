# CCC tailor API (run CCC on 3001 if this app uses 3000)
CCC_API_URL=http://localhost:3001
TAILOR_API_KEY=

# Shared operator secret. Required unless NODE_ENV=development.
# Leave empty for local `npm run dev` (loopback-only). Send as x-operator-token.
OPERATOR_TOKEN=

# Optional CCC fetch deadline in ms (default 120000).
# Values above 125000 are clamped so the route can return 504 before maxDuration (130s).
# CCC_FETCH_TIMEOUT_MS=120000
