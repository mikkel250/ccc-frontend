# CCC tailor API (run CCC on 3001 if this app uses 3000)
CCC_API_URL=http://localhost:3001
TAILOR_API_KEY=

# Shared operator secret. Required in every non-local environment
# (preview, staging, production, CI, `next start`). Send as x-operator-token.
# Leave empty only for local `npm run dev` (loopback-only).
OPERATOR_TOKEN=

# Optional CCC fetch deadline in ms (default 120000). Clamped at 120000 so the
# abort fires before the 130s route maxDuration. Keep at or below that cap.
# CCC_FETCH_TIMEOUT_MS=120000
