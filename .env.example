# CCC tailor API (run CCC on 3001 if this app uses 3000)
CCC_API_URL=http://localhost:3001
TAILOR_API_KEY=

# Shared operator secret. Required in production. Send as x-operator-token.
# Leave empty for local `npm run dev` (loopback-only).
OPERATOR_TOKEN=

# Optional CCC fetch deadline in ms (default 120000). Keep below 180000 so the UI can wait for a 504.
# CCC_FETCH_TIMEOUT_MS=120000
